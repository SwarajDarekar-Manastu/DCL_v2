{
  "name": "dcl-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "gen:api": "cd ../.. && uv run -q python frontend/console/scripts/export_openapi.py > frontend/console/openapi.json && cd frontend/console && openapi-typescript openapi.json -o src/lib/api_schema.d.ts && rm openapi.json"
  },
  "dependencies": {
    "@azure/msal-browser": "4.30.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
