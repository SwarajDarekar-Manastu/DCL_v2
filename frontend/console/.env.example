# DCL Console build-time settings (names only; values are not secrets but stay out of git).
# Read in one place: src/lib/config.ts
VITE_API_BASE_URL=
# msal (Entra ID), or dev under the Vite dev server only: the dev sign-in token is then read from
# DCL_CONSOLE_DEV_TOKEN in the repository .env (VITE_DEV_TOKEN here overrides it). Builds never contain it.
VITE_AUTH_MODE=msal
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=
