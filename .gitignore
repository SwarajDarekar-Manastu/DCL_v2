frontend/console/build/
dist/
build/

# Local data and model caches (never commit corpus files or vectors)
/data/
/minio-data/
/pgdata/
/models/
*.parquet
*.db
*.sqlite

# Editor and OS noise
.vscode/
.idea/
.DS_Store
