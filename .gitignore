# Secrets: the env file is root-owned on the host and never enters the repository or an image.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/

# Session worktrees and local tooling
.worktrees/
.claude/worktrees/
.venv/
venv/
