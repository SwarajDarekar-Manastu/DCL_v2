# DCL v2 environment contract (docs/architecture/01_system_overview_and_tech_stack.md §7.1).
# Names only. The real .env sits at the repository root (compose under backend/devops/ reads ../../.env),
# root-owned, mode 600, never committed and never copied into an image. Placeholder values are refused at startup.

# Graph identity. DCL_AUTH_MODE: delegated. DCL_PERMISSION_OPTION: A (Files.SelectedOperations.Selected, preferred) or B (Files.Read.All).
DCL_TENANT_ID=
DCL_CLIENT_ID=
DCL_AUTH_MODE=
DCL_DELEGATED_USERNAME=
DCL_PERMISSION_OPTION=
DCL_TOKEN_CACHE_PATH=
DCL_TOKEN_DIR=
# Fernet key for the encrypted v2 token cache (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
DCL_TOKEN_CACHE_KEY=

# Graph roots, comma-separated, same order in both lists.
DCL_DRIVE_ID=
DCL_FOLDER_IDS=
DCL_FOLDER_PATHS=

# Graph negative test: an item the identity must not be able to read.
DCL_TEST_OUTSIDE_ITEM_ID=
# Drive of that item; S1 falls back to DCL_DRIVE_ID when empty.
DCL_TEST_OUTSIDE_DRIVE_ID=

# Future application-permission variant (unused until decision H4 changes).
DCL_SECRET_STORE=
DCL_CERTIFICATE_PATH=
DCL_CERTIFICATE_THUMBPRINT=

# Gemini through the Manastu Cloud Run gateway. GEMINI_BACKEND: gateway. GEMINI_THINKING_LEVEL: minimal|low|medium|high.
# GOOGLE_API_KEY must never be set; the client refuses to start if it is.
GEMINI_BACKEND=
GEMINI_GATEWAY_URL=
GEMINI_GATEWAY_KEY=
# Legacy alias of GEMINI_GATEWAY_KEY, read only when the primary is empty. A value starting with AIza is refused.
DCL_GEMINI_API_KEY=
GEMINI_THINKING_LEVEL=
GEMINI_INCLUDE_THOUGHTS=
GEMINI_CONTEXT_CACHE=
GEMINI_CACHE_TTL_S=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Alerts (Teams webhook; operational alerts only).
DCL_ALERT_WEBHOOK_URL=

# Local stack.
DCL_DB_USER=
DCL_DB_PASSWORD=
DCL_DB_PORT=
DCL_DATABASE_URL=
DCL_BIND_HOST=
DCL_PORTAINER_USER=
DCL_PORTAINER_PASSWORD=

# Service wiring. DCL_ENV: dev|staging|prod (dev applies local defaults for Redis, MinIO endpoint, models and base URLs;
# staging/prod require explicit values). DCL_ROLE: api|models|all, set per container by compose (ROLE is a deprecated alias).
DCL_ENV=
DCL_ROLE=
DCL_REDIS_URL=
DCL_MINIO_ENDPOINT=
DCL_MINIO_ACCESS_KEY=
DCL_MINIO_SECRET_KEY=
DCL_MINIO_SECURE=
DCL_MODELS_URL=
DCL_API_BASE_URL=
DCL_CONSOLE_BASE_URL=
DCL_PIPE_SHARED_SECRET=

# MinIO container root pair, read by compose only. In staging/prod the application keys above are a separate service account.
DCL_MINIO_ROOT_USER=
DCL_MINIO_ROOT_PASSWORD=

# Console authentication (Entra ID; tenant reuses DCL_TENANT_ID). Group values are Entra group object ids.
# DCL_CONSOLE_ALLOWED_ORIGINS is comma-separated.
DCL_CONSOLE_API_AUDIENCE=
DCL_CONSOLE_GROUP_REVIEWERS=
DCL_CONSOLE_GROUP_ADMINS=
DCL_CONSOLE_GROUP_EXTERNAL_SEARCH=
DCL_CONSOLE_ALLOWED_ORIGINS=
